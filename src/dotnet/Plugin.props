<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.Rider.SDK -->
    <!-- Gradle passes SdkVersion from gradle.properties; this default is for builds outside Gradle (IDE, dotnet test). -->
    <SdkVersion Condition="'$(SdkVersion)' == ''">2026.3.0-eap06</SdkVersion>

    <Title>LamaRider</Title>
    <Description>Metalama tooling for Rider</Description>
    <Authors>LamaRider</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) LamaRider</Copyright>
  </PropertyGroup>

</Project>
