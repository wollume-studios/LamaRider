<idea-plugin require-restart="true">
  <id>dev.lamarider</id>
  <name>LamaRider</name>
  <version>_PLACEHOLDER_</version>
  <vendor>LamaRider</vendor>
  <depends>com.intellij.modules.rider</depends>

  <!-- description: docs/plugin-description.html, set by patchPluginXml -->
  <description>Metalama tooling for Rider.</description>

  <extensions defaultExtensionNs="com.intellij">
    <rd.solutionExtListener endpoint="IDE Frontend" listener="dev.lamarider.LamaRiderProtocolListener"/>
    <toolWindow id="LamaRider" anchor="right" icon="/icons/aspectExplorer.svg"
                factoryClass="dev.lamarider.explorer.AspectExplorerToolWindowFactory"/>
    <notificationGroup id="LamaRider" displayType="BALLOON"/>
    <projectConfigurable parentId="tools" id="dev.lamarider.settings" displayName="LamaRider"
                         instance="dev.lamarider.settings.LamaRiderConfigurable"/>
    <editorNotificationProvider implementation="dev.lamarider.errors.MetalamaErrorBanner"/>
  </extensions>

  <projectListeners>
    <listener class="dev.lamarider.debug.CompileTimeBreakpoints" topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
  </projectListeners>

  <actions>
    <action id="LamaRider.Refresh" class="dev.lamarider.RefreshAction"/>
    <action id="LamaRider.MetalamaDiff" class="dev.lamarider.diff.MetalamaDiffAction" text="Metalama Diff"
            description="Compare source with Metalama-transformed code">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="Visual Studio" first-keystroke="control K" second-keystroke="0"/>
    </action>
    <action id="LamaRider.ShowAspects" class="dev.lamarider.actions.ShowAspectsAction" text="Show Metalama Aspects"
            description="Aspects applied to the declaration at the caret">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.ShowTransformedCode" class="dev.lamarider.actions.ShowTransformedCodeAction" text="Show Transformed Code"
            description="Transformed code of the declaration at the caret, in a popup">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.OpenTransformedFile" class="dev.lamarider.actions.OpenTransformedFileAction" text="Open Transformed File"
            description="Open the Metalama-transformed file from obj/ (set breakpoints there while debugging transformed code)">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.DebugTransformedCode" class="dev.lamarider.actions.DebugTransformedCodeAction" text="Debug Transformed Code"
            description="Set MetalamaDebugTransformedCode in the solution's Directory.Build.props">
    </action>
    <action id="LamaRider.ConfigureTests" class="dev.lamarider.actions.ConfigureTestsAction" text="Configure Rider for Metalama Tests"
            description="xUnit discovery by Test Runner and no orphaned-process prompt for diff tools (Metalama aspect tests)">
    </action>
    <action id="LamaRider.AutoBuild" class="dev.lamarider.actions.AutoBuildAction" text="Metalama: Build After Aspect Changes"
            description="Builds the project after aspect or template code is saved, so Metalama's design-time analysis resumes (LAMA0118)">
    </action>
    <action id="LamaRider.TrackCaret" class="dev.lamarider.explorer.TrackCaretAction" text="Track Caret"
            description="LamaRider window: show the aspects that affect the code at the caret" icon="AllIcons.General.Locate"/>
    <action id="LamaRider.CreateAspectTest" class="dev.lamarider.actions.CreateAspectTestAction" text="Create Metalama Aspect Test"
            description="Aspect test for the aspect class at the caret, in an existing or new aspect test project">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.AcceptAspectTestOutput" class="dev.lamarider.actions.AcceptAspectTestOutputAction" text="Accept Metalama Test Output"
            description="Save the last run's transformed output of this aspect test as its .t.cs snapshot">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.RunAspectTest" class="dev.lamarider.actions.RunAspectTestAction" text="Run Metalama Aspect Test"
            description="Run this aspect test in the unit test runner" icon="AllIcons.RunConfigurations.TestState.Run">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.DebugAspectTest" class="dev.lamarider.actions.DebugAspectTestAction" text="Debug Metalama Aspect Test"
            description="Debug this aspect test: breakpoints in aspects, templates and fabrics stop" icon="AllIcons.Actions.StartDebugger">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
    </action>
    <action id="LamaRider.OnlyAtCaret" class="dev.lamarider.explorer.OnlyAtCaretAction"/>
    <action id="LamaRider.DebugLamaDebug" class="dev.lamarider.actions.DebugWithLamaDebugAction"/>
    <action id="LamaRider.Settings" class="dev.lamarider.actions.OpenSettingsAction"/>
    <group id="LamaRider.Gear" text="LamaRider">
      <reference ref="LamaRider.DebugLamaDebug"/>
      <reference ref="LamaRider.DebugTransformedCode"/>
      <reference ref="LamaRider.AutoBuild"/>
      <reference ref="LamaRider.ConfigureTests"/>
      <separator/>
      <reference ref="LamaRider.Settings"/>
    </group>
  </actions>
</idea-plugin>
